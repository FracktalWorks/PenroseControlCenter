# Penrose printer connection settings.
#
# Copy to .env and fill in. .env is gitignored - never commit it.
#     cp .env.example .env
#
# Every value can also be passed as a CLI flag or exported as an
# environment variable; the flag wins, then the environment, then .env.

# ── Printer ───────────────────────────────────────────────────────────────
# IP or hostname of the machine (the Pi running OctoPrint).
PENROSE_HOST=192.168.1.100
PENROSE_PORT=5000

# OctoPrint API key: Settings -> API in the web interface, or the
# per-user key under Settings -> Access Control.
PENROSE_API_KEY=

# ── SSH ───────────────────────────────────────────────────────────────────
# Defaults to PENROSE_HOST if unset. Set separately only when SSH reaches
# the machine on a different address or port.
# PENROSE_SSH_HOST=
PENROSE_SSH_USER=pi
# PENROSE_SSH_PORT=22

# A key is strongly preferred over a password.
# PENROSE_SSH_KEY=~/.ssh/id_rsa
# PENROSE_SSH_PASSWORD=

# ── Paths on the machine ──────────────────────────────────────────────────
# Only set these if this install differs from the standard layout.
# PENROSE_PRINTER_CFG=/home/pi/printer.cfg
# PENROSE_VARIABLES_CFG=/home/pi/.octoprint/data/klipper/variables.cfg
# PENROSE_KLIPPY_LOG=/tmp/klippy.log
# PENROSE_OCTOPRINT_LOG=/home/pi/.octoprint/logs/octoprint.log
# PENROSE_MODE_STATE_DIR=/home/pi/.penrose
